{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash({{PYTHON_CMD}} .claude/hooks/guard.py check)",
      "Bash({{PYTHON_CMD}} .claude/hooks/guard.py check *)",
      "Bash({{PYTHON_CMD}} -m unittest discover -s .claude/hooks/tests)",
      "Bash({{PYTHON_CMD}} -m unittest discover -s .claude/hooks/tests *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit --amend)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git update-index *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(uv add *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "{{PYTHON_CMD}}", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "pre"], "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "{{PYTHON_CMD}}", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "post"], "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON_CMD}}", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "stop"], "timeout": 60 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON_CMD}}", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "stop"], "timeout": 60 }
        ]
      }
    ]
  }
}
